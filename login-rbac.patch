--- /dev/null
+++ b/frontend/src/styles/auth.css
@@ -0,0 +1,22 @@
+/* ------------------------------------------------------------------ login + user box */
+.login-page { min-height: 100vh; display: grid; place-items: center; padding: var(--space-4); }
+.login-card { width: 100%; max-width: 420px; display: grid; gap: var(--space-4); }
+.login-brand { display: flex; gap: 12px; align-items: center; }
+.login-brand h1 { font-size: 22px; margin: 0; }
+.login-brand p { margin: 2px 0 0; }
+.login-form { display: grid; gap: var(--space-3); }
+.login-form label { display: grid; gap: 6px; font-weight: 500; }
+.login-form input { width: 100%; min-width: 0; padding: 10px 12px; font: inherit; }
+.login-form .btn { width: 100%; justify-content: center; }
+.login-accounts summary { cursor: pointer; font-weight: 500; }
+.login-accounts ul { list-style: none; padding: 0; margin: 8px 0; display: grid; gap: 4px; }
+.login-accounts li { display: flex; justify-content: space-between; gap: 8px; flex-wrap: wrap; }
+.userbox { margin-left: auto; display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
+.userbox .who { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; }
+.role-chip { font-size: 11.5px; font-weight: 600; padding: 2px 8px; border-radius: 999px; border: 1px solid var(--border); }
+.role-chip[data-role="support"] { color: var(--series-ai); border-color: var(--series-ai); }
+.btn.small { padding: 6px 12px; font-size: 13px; }
+.banner.info { background: var(--surface); border-color: var(--border); color: inherit; }
+@media (max-width: 700px) {
+  .userbox .scope { display: none; }
+}
