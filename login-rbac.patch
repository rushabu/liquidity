diff --git a/frontend/src/auth/AuthContext.tsx b/frontend/src/auth/AuthContext.tsx
new file mode 100644
index 0000000..e8e7db3
--- /dev/null
+++ b/frontend/src/auth/AuthContext.tsx
@@ -0,0 +1,79 @@
+import { createContext, useCallback, useContext, useEffect, useMemo, useState, type ReactNode } from "react";
+import { Navigate, useLocation } from "react-router-dom";
+import { clearAiCache, setUnauthorizedHandler } from "../api/client";
+import { clearSticky } from "../lib/sticky";
+import { getCurrentSession, refreshSession, setCurrentSession, signIn, type Profile, type Session } from "./session";
+
+interface Auth {
+  user: Profile | null;
+  login: (email: string, password: string) => Promise<Profile>;
+  logout: (reason?: string) => void;
+  notice: string | null;           // why the user was signed out (expired session), shown on the login page
+}
+
+const AuthContext = createContext<Auth | null>(null);
+
+/** Everything remembered in memory belongs to the user who saw it: wipe it whenever the user changes. */
+function forgetData() {
+  clearAiCache();
+  clearSticky();
+}
+
+export function AuthProvider({ children }: { children: ReactNode }) {
+  const [session, setSession] = useState<Session | null>(getCurrentSession);
+  const [notice, setNotice] = useState<string | null>(null);
+
+  const apply = useCallback((s: Session | null) => { setCurrentSession(s); setSession(s); }, []);
+
+  const logout = useCallback((reason?: string) => {
+    forgetData();
+    apply(null);
+    setNotice(reason ?? null);
+  }, [apply]);
+
+  const login = useCallback(async (email: string, password: string) => {
+    const s = await signIn(email, password);
+    forgetData();
+    setNotice(null);
+    apply(s);
+    return s.user;
+  }, [apply]);
+
+  // any 401 from the API (expired or revoked token) signs out
+  useEffect(() => {
+    setUnauthorizedHandler(() => logout("Your session has expired. Please sign in again."));
+    return () => setUnauthorizedHandler(null);
+  }, [logout]);
+
+  // renew the access token a minute before it expires
+  useEffect(() => {
+    if (!session?.refresh_token) return;
+    const wait = Math.max(5_000, session.expires_at * 1000 - Date.now() - 60_000);
+    const t = setTimeout(() => {
+      refreshSession(session.refresh_token!).then(apply, () => logout("Your session has expired. Please sign in again."));
+    }, wait);
+    return () => clearTimeout(t);
+  }, [session, apply, logout]);
+
+  const value = useMemo<Auth>(() => ({ user: session?.user ?? null, login, logout, notice }), [session, login, logout, notice]);
+  return <AuthContext.Provider value={value}>{children}</AuthContext.Provider>;
+}
+
+export function useAuth(): Auth {
+  const a = useContext(AuthContext);
+  if (!a) throw new Error("useAuth must be used inside <AuthProvider>");
+  return a;
+}
+
+/** The signed-in user, or null outside the provider (pages rendered on their own in unit tests). */
+export function useUser(): Profile | null {
+  return useContext(AuthContext)?.user ?? null;
+}
+
+/** Route guard: no session -> /login, remembering where the user wanted to go. */
+export function RequireAuth({ children }: { children: ReactNode }) {
+  const { user } = useAuth();
+  const loc = useLocation();
+  if (!user) return <Navigate to="/login" replace state={{ from: loc.pathname + loc.search }} />;
+  return <>{children}</>;
+}
diff --git a/frontend/src/auth/session.ts b/frontend/src/auth/session.ts
new file mode 100644
index 0000000..30a03b7
--- /dev/null
+++ b/frontend/src/auth/session.ts
@@ -0,0 +1,65 @@
+import { API_URL, ApiError, setTokenProvider } from "../api/client";
+
+/** The signed-in user as the API sees it (role and location come from Supabase app_metadata). */
+export interface Profile {
+  id: string;
+  email: string | null;
+  role: "support" | "standard";
+  location: string | null;
+  scope: string | null;          // "All locations" for support, else the user's location
+  can_upload: boolean;
+}
+
+export interface Session {
+  access_token: string;
+  refresh_token: string | null;
+  expires_at: number;            // unix seconds
+  user: Profile;
+}
+
+const KEY = "liquidplus.session";
+
+/** Per browser tab (sessionStorage): closing the tab signs out; nothing is kept on disk between visits. */
+export function loadSession(): Session | null {
+  try {
+    const raw = sessionStorage.getItem(KEY);
+    if (!raw) return null;
+    const s = JSON.parse(raw) as Session;
+    return s.expires_at * 1000 > Date.now() ? s : null;
+  } catch {
+    return null;
+  }
+}
+
+export function saveSession(s: Session | null): void {
+  try {
+    if (s) sessionStorage.setItem(KEY, JSON.stringify(s));
+    else sessionStorage.removeItem(KEY);
+    sessionStorage.removeItem("liquidplus.token");            // the old manual-token key
+  } catch {
+    /* storage blocked: the session lives in memory only */
+  }
+}
+
+let current: Session | null = loadSession();
+setTokenProvider(() => current?.access_token ?? null);
+export const setCurrentSession = (s: Session | null) => { current = s; saveSession(s); };
+export const getCurrentSession = () => current;
+
+async function post<T>(path: string, body: unknown): Promise<T> {
+  let res: Response;
+  try {
+    res = await fetch(`${API_URL}${path}`, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) });
+  } catch {
+    throw new ApiError("NETWORK", "Cannot reach the server. Is the backend running?");
+  }
+  const data = await res.json().catch(() => null);
+  if (!res.ok) {
+    const e = (data as { error?: { code?: string; message?: string } } | null)?.error;
+    throw new ApiError(e?.code ?? "HTTP_ERROR", e?.message ?? `Request failed (${res.status})`, res.status);
+  }
+  return data as T;
+}
+
+export const signIn = (email: string, password: string) => post<Session>("/api/auth/login", { email, password });
+export const refreshSession = (refresh_token: string) => post<Session>("/api/auth/refresh", { refresh_token });
