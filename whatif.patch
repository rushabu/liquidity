+.whatif-chart rect.scen, .whatif-chart .key.scen { fill: var(--primary); background: var(--primary); }
+.whatif-chart .tick { font-size: 12px; fill: var(--muted); }
+.whatif-chart .tick[data-tone="shortfall"] { fill: var(--error); font-weight: 600; }
+.whatif-chart .tick[data-tone="surplus"] { fill: var(--success); font-weight: 600; }
+.whatif-chart .legend { display: flex; gap: var(--space-3); flex-wrap: wrap; font-size: 13px; margin-top: 6px; align-items: center; }
+.whatif-chart .key { display: inline-block; width: 10px; height: 10px; border-radius: 2px; margin-right: 4px; vertical-align: middle; }
+@media (max-width: 900px) {
+  .shift-grid, .whatif-grid { grid-template-columns: 1fr; }
+}
