diff --git a/frontend/src/components/ai/CompareView.tsx b/frontend/src/components/ai/CompareView.tsx
new file mode 100644
index 0000000..ea1d755
--- /dev/null
+++ b/frontend/src/components/ai/CompareView.tsx
@@ -0,0 +1,153 @@
+import { useEffect, useMemo, useRef, useState } from "react";
+import { getComparison, type ApiError, type CompareResponse, type Recommendation, type Segment, type Side } from "../../api/client";
+import { formatInt, formatMoney, formatPct, formatSignedCompact } from "../../lib/format";
+import { MonthlyChart } from "./MonthlyChart";
+import type { DrillPreset, PageMeta, Shared } from "./types";
+
+const SEVERITY = { high: "error", medium: "warning", low: "success" } as const;
+
+export function Actions({ items, empty, compact = false }: { items: Recommendation[]; empty: string; compact?: boolean }) {
+  if (!items.length) return <p className="empty">{empty}</p>;
+  return (
+    <ol className="actions">
+      {items.map((r) => (
+        <li key={`${r.scope}-${r.bucket}-${r.action}`}>
+          <span className="chip" data-tone={SEVERITY[r.severity]}>{r.severity}</span>
+          <div>
+            <b>{r.action}</b> <span className="meta">{r.scope} · {r.bucket}</span>
+            <p>{compact ? r.rationale.split(/(?<=\.)\s/)[0] : r.rationale}</p>
+          </div>
+        </li>
+      ))}
+    </ol>
+  );
+}
+
+export function CompareView({ shared, onDrill, onMeta }: { shared: Shared; onDrill: (p: DrillPreset) => void; onMeta: (m: PageMeta) => void }) {
+  const { currency, setCurrency, location, setLocation } = shared;
+  const [side, setSide] = useState<Side | "">("");
+  const [segment, setSegment] = useState<Segment | "">("");
+  const [data, setData] = useState<CompareResponse | null>(null);
+  const [error, setError] = useState<ApiError | null>(null);
+  const [month, setMonth] = useState<number | null>(null);
+  const seq = useRef(0);
+
+  useEffect(() => {
+    const mine = ++seq.current;
+    setError(null);
+    getComparison({ currency: currency || undefined, location: location || undefined, side: side || undefined, segment: segment || undefined })
+      .then((d) => {
+        if (mine !== seq.current) return;
+        setData(d); onMeta(d.metadata);
+        if (!currency) setCurrency(d.metadata.currency);
+        setMonth((m) => m ?? d.kpis.deepest_opposite.month);
+      }, (e: ApiError) => { if (mine === seq.current) setError(e); });
+  }, [currency, location, side, segment]);   // eslint-disable-line react-hooks/exhaustive-deps
+
+  const sel = useMemo(() => data?.months.find((m) => m.month === month) ?? null, [data, month]);
+  if (error) return <div className="banner" role="alert">{error.message}</div>;
+  if (!data) return <p className="loading">Comparing the two views and running 1,000 simulations…</p>;
+  const md = data.metadata, k = data.kpis;
+  const ccy = md.currency;
+
+  return (
+    <>
+      <section className="card ai-filters" aria-label="Filters">
+        <div role="tablist" aria-label="Currency" className="filters pills">
+          {md.currencies.map((c) => (
+            <button key={c} role="tab" type="button" aria-selected={c === ccy} className={c === ccy ? "btn ai" : "btn secondary"}
+                    onClick={() => { setCurrency(c); setLocation(""); setMonth(null); }}>{c}</button>
+          ))}
+        </div>
+        <div className="filters">
+          <label>Location
+            <select value={location} onChange={(e) => setLocation(e.target.value)}>
+              <option value="">All locations</option>
+              {md.locations.map((l) => <option key={l} value={l}>{l}</option>)}
+            </select>
+          </label>
+          <label>Side
+            <select value={side} onChange={(e) => setSide(e.target.value as Side | "")}>
+              <option value="">Assets + liabilities</option>
+              <option value="asset">Assets (loans)</option>
+              <option value="liability">Liabilities (deposits)</option>
+            </select>
+          </label>
+          <label>Segment
+            <select value={segment} onChange={(e) => setSegment(e.target.value as Segment | "")}>
+              <option value="">All</option>
+              {["Retail", "Corporate", "SME", "Institutional"].map((s) => <option key={s} value={s}>{s}</option>)}
+            </select>
+          </label>
+        </div>
+      </section>
+
+      <section className="kpi-row" aria-label="Key figures">
+        <div className="kpi"><span>Contracts moved earlier</span><b>{formatInt(k.moved)} / {formatInt(k.total)}</b><small>changed bucket · {formatInt(k.shifted)} date moved</small></div>
+        <div className="kpi"><span>Biggest gain in early cash</span><b className="pos">{formatSignedCompact(k.biggest_gain.amount)} · M{k.biggest_gain.month}</b></div>
+        <div className="kpi"><span>Deepest opposite shift</span><b className="neg">{formatSignedCompact(k.deepest_opposite.amount)} · M{k.deepest_opposite.month}</b></div>
+        <div className="kpi"><span>Total net gap</span><b className={k.ai_total < 0 ? "neg" : "pos"}>{formatSignedCompact(k.ai_total)} {Math.abs(k.ai_total - k.det_total) < 1 ? "(same)" : ""}</b><small>only timing changes</small></div>
+      </section>
+
+      <div className="ai-grid">
+        <section className="card" aria-label="Cumulative net gap by month">
+          <MonthlyChart months={data.months} currency={ccy} selected={month} onSelect={setMonth} />
+        </section>
+        <section className="card" aria-label="Bucket comparison">
+          <h2>Bucket comparison</h2>
+          <p className="hint">Net gap, {ccy}{location ? ` · ${location}` : ""}</p>
+          <div className="table-wrap">
+            <table className="compact">
+              <thead><tr><th>Bucket</th><th className="num">Determ.</th><th className="num">AI</th><th className="num">Shift</th></tr></thead>
+              <tbody>
+                {data.buckets.map((b) => (
+                  <tr key={b.bucket} data-selected={sel?.bucket === b.bucket ? "" : undefined}>
+                    <td><button type="button" className="link-btn ai" onClick={() => onDrill({ bucket: b.bucket, currency: ccy, side: side || undefined, segment: segment || undefined, moved_only: true })}>{b.bucket}</button></td>
+                    <td className="num mono">{formatSignedCompact(b.det_net)}</td>
+                    <td className="num mono">{formatSignedCompact(b.ai_net)}</td>
+                    <td className="num mono" data-tone={b.delta < 0 ? "shortfall" : b.delta > 0 ? "surplus" : undefined}>{formatSignedCompact(b.delta)}</td>
+                  </tr>
+                ))}
+              </tbody>
+            </table>
+          </div>
+          {sel && sel.month > 0 && (
+            <div className="selected-month">
+              <b>Selected: month {sel.month} ({formatSignedCompact(sel.diff)})</b>
+              <p>{sel.note} <button type="button" className="link-btn ai" onClick={() => onDrill({ bucket: sel.bucket ?? undefined, currency: ccy, moved_only: true })}>See why → Drill down →</button></p>
+              <small className="meta">Month ends {sel.end_date}, in bucket {sel.bucket}.</small>
+            </div>
+          )}
+          {data.buckets[0].p5 !== null && (
+            <details className="ranges">
+              <summary>Simulated range (P5–P95)</summary>
+              <table className="compact">
+                <thead><tr><th>Bucket</th><th className="num">P5</th><th className="num">P95</th><th className="num">Shortfall</th></tr></thead>
+                <tbody>{data.buckets.map((b) => (
+                  <tr key={b.bucket}><td>{b.bucket}</td><td className="num mono">{formatSignedCompact(b.p5 ?? 0)}</td><td className="num mono">{formatSignedCompact(b.p95 ?? 0)}</td><td className="num mono">{formatPct(b.p_shortfall ?? 0)}</td></tr>
+                ))}</tbody>
+              </table>
+            </details>
+          )}
+        </section>
+      </div>
+
+      <section className="card" aria-label="Recommended actions">
+        <div className="table-head">
+          <div>
+            <h2>Recommended actions · {ccy}{location ? ` · ${location}` : ""}</h2>
+            <p className="hint">From the AI-adjusted gap of each bucket and its simulated bad case.</p>
+          </div>
+        </div>
+        <Actions items={data.recommendations} empty="No action needed." />
+        {data.overview.length > 0 && (
+          <details className="overview">
+            <summary><b>Top actions across all currencies</b></summary>
+            <Actions compact items={data.overview.slice(0, 5)} empty="" />
+          </details>
+        )}
+        <ul className="meta notes">{data.notes.map((n) => <li key={n}>{n}</li>)}<li>Total {formatMoney(k.ai_total)} {ccy} in both views.</li></ul>
+      </section>
+    </>
+  );
+}
diff --git a/frontend/src/components/ai/DrillView.tsx b/frontend/src/components/ai/DrillView.tsx
new file mode 100644
index 0000000..08dd3d9
--- /dev/null
+++ b/frontend/src/components/ai/DrillView.tsx
@@ -0,0 +1,212 @@
+import { useEffect, useRef, useState } from "react";
+import {
+  downloadAiPredictions, getAiExplanation, getAiTransactions, type AiExplanation, type AiTxnPage, type AiTxnQuery,
+  type ApiError, type BucketKey, type Segment, type Side,
+} from "../../api/client";
+import { formatInt, formatMoney, formatPct, formatSignedCompact } from "../../lib/format";
+import type { DrillPreset, Shared } from "./types";
+
+const PAGE = 10;
+const BUCKETS: BucketKey[] = ["0-1M", "1-3M", "3-12M", "1-5Y", ">5Y"];
+const P_RANGES = { all: [0, 1], "0-20": [0, 0.2], "20-40": [0.2, 0.4], "40-100": [0.4, 1], "60-100": [0.6, 1] } as const;
+const SPREADS = { all: [undefined, undefined], "gt1": [1, undefined], "gt0": [0, undefined], "lt0": [undefined, 0], "ltm1": [undefined, -1] } as const;
+type PRange = keyof typeof P_RANGES;
+type SRange = keyof typeof SPREADS;
+const sign = (n: number, d = 1) => `${n > 0 ? "+" : n < 0 ? "−" : ""}${Math.abs(n).toFixed(d)}`;
+
+export function WhyPanel({ id, onClose }: { id: string; onClose: () => void }) {
+  const [e, setE] = useState<AiExplanation | null>(null);
+  const [err, setErr] = useState<string | null>(null);
+  useEffect(() => {
+    let live = true;
+    setE(null); setErr(null);
+    getAiExplanation(id).then((d) => live && setE(d), (x: ApiError) => live && setErr(x.message));
+    return () => { live = false; };
+  }, [id]);
+  const maxLo = Math.max(0.05, ...(e?.rationale.drivers ?? []).map((d) => Math.abs(d.log_odds)));
+  const groups = e ? [
+    ...e.rationale.drivers.filter((d) => !["tenor_years", "log_amount"].includes(d.feature) && Math.abs(d.log_odds) >= 0.01).slice(0, 4),
+  ] : [];
+  const tenorAmount = e ? e.rationale.drivers.filter((d) => ["tenor_years", "log_amount"].includes(d.feature)).reduce((s, d) => s + d.log_odds, 0) : 0;
+  return (
+    <aside className="card why-panel" aria-label={`Why ${id} moved`}>
+      <div className="why-head">
+        <h2>Why {id} {e && e.shift_days > 0 ? "moved" : "stays"}</h2>
+        {e && <span className="chip" data-tone="warning">P(early) {formatPct(e.p_early)}</span>}
+        <button type="button" className="close-x" aria-label="Close" onClick={onClose}>×</button>
+      </div>
+      {err && <p className="tbl-error" role="alert">{err}</p>}
+      {!e && !err && <p className="loading">Loading…</p>}
+      {e && (
+        <>
+          <p className="hint">{e.type === "asset" ? "Asset" : "Liability"} · {e.customer_segment} · {e.interest_rate_pct.toFixed(2)}% vs market {e.market_rate_pct.toFixed(2)}%</p>
+          <ul className="lo-bars">
+            {groups.map((d) => (
+              <li key={d.feature}>
+                <span title={d.value}>{d.feature === "incentive_pp" ? `Rate spread ${sign(e.spread_pp)} pp` : d.feature === "customer_segment" ? `Segment: ${e.customer_segment}` : d.label}</span>
+                <span className="lo-bar" aria-hidden="true"><i data-dir={d.direction} style={{ width: `${(Math.abs(d.log_odds) / maxLo) * 50}%`, [d.log_odds >= 0 ? "left" : "right"]: "50%" }} /></span>
+                <b className="mono">{sign(d.log_odds, 2)}</b>
+              </li>
+            ))}
+            <li><span>Tenor, amount</span><span className="lo-bar" aria-hidden="true"><i data-dir="neutral" style={{ width: "1px", left: "50%" }} /></span><b className="mono">{Math.abs(tenorAmount) < 0.01 ? "~0" : sign(tenorAmount, 2)}</b></li>
+          </ul>
+          <p className="meta">Log-odds contribution vs an average contract. Red pushes towards leaving early.</p>
+          <dl className="exit-facts">
+            <div><dt>Contractual maturity</dt><dd>{e.contractual_maturity_date} · {e.deterministic_bucket ?? "past due"}</dd></div>
+            <div><dt>Predicted exit</dt><dd className={e.shift_days > 0 ? "pos" : undefined}>{e.adjusted_maturity_date} · {e.ai_bucket ?? "past due"}</dd></div>
+            <div><dt>Cash amount</dt><dd>{formatMoney(e.cash_at_maturity)}<small>(unchanged)</small></dd></div>
+          </dl>
+          <p className="meta">{e.rationale.summary}</p>
+          <code className="formula">{e.formula}</code>
+        </>
+      )}
+    </aside>
+  );
+}
+
+export function DrillView({ shared, preset }: { shared: Shared; preset: DrillPreset | null }) {
+  const { currency, setCurrency, location } = shared;
+  const [bucket, setBucket] = useState<BucketKey | "">(preset?.bucket ?? "1-3M");
+  const [side, setSide] = useState<Side | "">(preset?.side ?? "");
+  const [segment, setSegment] = useState<Segment | "">(preset?.segment ?? "");
+  const [pRange, setPRange] = useState<PRange>("all");
+  const [sRange, setSRange] = useState<SRange>("all");
+  const [moved, setMoved] = useState<boolean>(preset?.moved_only ?? true);
+  const [sort, setSort] = useState<"p_early" | "shift_days" | "spread_pp" | "cash_at_maturity">("p_early");
+  const [page, setPage] = useState(1);
+  const [data, setData] = useState<AiTxnPage | null>(null);
+  const [err, setErr] = useState<string | null>(null);
+  const [selected, setSelected] = useState<string | null>(null);
+  const [exporting, setExporting] = useState(false);
+  const seq = useRef(0);
+
+  useEffect(() => {
+    if (!preset) return;
+    if (preset.bucket) setBucket(preset.bucket);
+    if (preset.currency) setCurrency(preset.currency);
+    setSide(preset.side ?? ""); setSegment(preset.segment ?? ""); setMoved(preset.moved_only ?? true);
+  }, [preset]);   // eslint-disable-line react-hooks/exhaustive-deps
+
+  const query: AiTxnQuery = {
+    currency: currency || undefined, location: location || undefined, bucket: bucket || undefined, type: side || undefined,
+    segment: segment || undefined, p_min: P_RANGES[pRange][0], p_max: P_RANGES[pRange][1],
+    spread_min: SPREADS[sRange][0], spread_max: SPREADS[sRange][1], moved_only: moved,
+  };
+  const key = JSON.stringify(query);
+  useEffect(() => { setPage(1); }, [key]);
+  useEffect(() => {
+    const mine = ++seq.current;
+    setErr(null);
+    getAiTransactions({ ...query, sort, order: "desc", page, page_size: PAGE })
+      .then((d) => {
+        if (mine !== seq.current) return;
+        setData(d);
+        setSelected((s) => (s && d.items.some((t) => t.transaction_id === s) ? s : d.items[0]?.transaction_id ?? null));
+      }, (e: ApiError) => { if (mine === seq.current) setErr(e.message); });
+  }, [key, sort, page]);   // eslint-disable-line react-hooks/exhaustive-deps
+
+  const pages = data ? Math.max(1, Math.ceil(data.total / PAGE)) : 1;
+  const exportCsv = () => { setExporting(true); downloadAiPredictions(query).catch((e: ApiError) => setErr(e.message)).finally(() => setExporting(false)); };
+
+  return (
+    <>
+      <section className="card ai-filters drill-filters" aria-label="Drill-down filters">
+        <label>AI bucket
+          <select value={bucket} onChange={(e) => setBucket(e.target.value as BucketKey | "")}>
+            <option value="">All</option>{BUCKETS.map((b) => <option key={b} value={b}>{b}</option>)}
+          </select>
+        </label>
+        <label>Currency
+          <select value={currency} onChange={(e) => setCurrency(e.target.value)}>
+            <option value="">All</option>{["EUR", "GBP", "HKD", "SGD", "USD"].map((c) => <option key={c} value={c}>{c}</option>)}
+          </select>
+        </label>
+        <label>Side
+          <select value={side} onChange={(e) => setSide(e.target.value as Side | "")}>
+            <option value="">All</option><option value="asset">Assets</option><option value="liability">Liabilities</option>
+          </select>
+        </label>
+        <label>Segment
+          <select value={segment} onChange={(e) => setSegment(e.target.value as Segment | "")}>
+            <option value="">All</option>{["Retail", "Corporate", "SME", "Institutional"].map((s) => <option key={s} value={s}>{s}</option>)}
+          </select>
+        </label>
+        <label>P(early) range
+          <select value={pRange} onChange={(e) => setPRange(e.target.value as PRange)}>
+            <option value="all">All</option><option value="0-20">0% – 20%</option><option value="20-40">20% – 40%</option>
+            <option value="40-100">40% – 100%</option><option value="60-100">60% – 100%</option>
+          </select>
+        </label>
+        <label>Spread
+          <select value={sRange} onChange={(e) => setSRange(e.target.value as SRange)}>
+            <option value="all">All</option><option value="gt1">&gt; +1.0 pp</option><option value="gt0">&gt; 0 pp</option>
+            <option value="lt0">&lt; 0 pp</option><option value="ltm1">&lt; −1.0 pp</option>
+          </select>
+        </label>
+        <label>Moved only
+          <select value={moved ? "yes" : "no"} onChange={(e) => setMoved(e.target.value === "yes")}>
+            <option value="yes">Yes</option><option value="no">No</option>
+          </select>
+        </label>
+        <button type="button" className="btn secondary ai-outline" onClick={exportCsv} disabled={exporting}>{exporting ? "Exporting…" : "Export CSV"}</button>
+      </section>
+
+      {data && (
+        <section className="kpi-row" aria-label="Selection">
+          <div className="kpi"><span>Contracts in selection</span><b>{formatInt(data.kpis.count)}</b></div>
+          <div className="kpi"><span>{bucket ? `Cash pulled into ${bucket}` : "Cash pulled in"}</span><b className={(data.kpis.cash_pulled_in ?? 0) < 0 ? "neg" : "pos"}>{data.kpis.cash_pulled_in === null ? "—" : formatSignedCompact(data.kpis.cash_pulled_in)}</b><small>{currency ? "" : "mixed currencies"}</small></div>
+          <div className="kpi"><span>Avg P(early)</span><b>{formatPct(data.kpis.avg_p_early)}</b></div>
+          <div className="kpi"><span>Avg spread</span><b>{sign(data.kpis.avg_spread_pp)} pp</b></div>
+        </section>
+      )}
+
+      <div className="ai-grid drill-grid">
+        <section className="card" aria-label="Contracts">
+          <div className="table-head">
+            <div><h2>Contracts</h2><p className="hint">Click a row to see why. Sort by any column.</p></div>
+          </div>
+          {err && <p className="tbl-error" role="alert">{err}</p>}
+          {!data && !err && <p className="loading">Loading…</p>}
+          {data && data.total === 0 && <p className="empty">No contracts match these filters.</p>}
+          {data && data.total > 0 && (
+            <>
+              <div className="table-wrap">
+                <table className="drill-table">
+                  <thead>
+                    <tr>
+                      <th>Contract</th><th>Side · Segment</th>
+                      <th className="num"><button type="button" className="th-sort" onClick={() => setSort("spread_pp")}>Contract vs market{sort === "spread_pp" ? " ↓" : ""}</button></th>
+                      <th><button type="button" className="th-sort" onClick={() => setSort("p_early")}>P(early){sort === "p_early" ? " ↓" : ""}</button></th>
+                      <th><button type="button" className="th-sort" onClick={() => setSort("shift_days")}>Contractual → AI{sort === "shift_days" ? " ↓" : ""}</button></th>
+                      <th>Main reason</th>
+                    </tr>
+                  </thead>
+                  <tbody>
+                    {data.items.map((t) => (
+                      <tr key={t.transaction_id} data-selected={selected === t.transaction_id ? "" : undefined} onClick={() => setSelected(t.transaction_id)} className="clickable">
+                        <td><button type="button" className="link-btn ai" aria-label={`Why ${t.transaction_id}`} onClick={(e) => { e.stopPropagation(); setSelected(t.transaction_id); }}>{t.transaction_id}</button></td>
+                        <td>{t.book === "asset" ? "Asset" : "Liability"} · {t.customer_segment}</td>
+                        <td className="num mono nowrap">{t.interest_rate_pct.toFixed(1)}% vs {t.market_rate_pct.toFixed(1)}%</td>
+                        <td className="pcell"><span className="pbar"><i style={{ width: `${Math.round(t.p_early * 100)}%` }} /></span><span className="mono">{formatPct(t.p_early)}</span></td>
+                        <td className="mono nowrap">{t.deterministic_bucket ?? "—"} → {t.bucket ?? "—"}</td>
+                        <td className="chips">{t.reasons.map((r) => <span key={r.text} className="rchip" data-tone={r.tone}>{r.text}</span>)}</td>
+                      </tr>
+                    ))}
+                  </tbody>
+                </table>
+              </div>
+              <div className="pager">
+                <span>Showing {data.items.length} of {formatInt(data.total)} · page {page} of {pages}</span>
+                <div>
+                  <button type="button" className="btn secondary" disabled={page <= 1} onClick={() => setPage(page - 1)}>Previous</button>
+                  <button type="button" className="btn secondary" disabled={page >= pages} onClick={() => setPage(page + 1)}>Next</button>
+                </div>
+              </div>
+            </>
+          )}
+        </section>
+        {selected ? <WhyPanel id={selected} onClose={() => setSelected(null)} /> : <aside className="card why-panel"><p className="empty">Select a contract to see why it moved.</p></aside>}
+      </div>
+    </>
+  );
+}
diff --git a/frontend/src/components/ai/LadderView.tsx b/frontend/src/components/ai/LadderView.tsx
new file mode 100644
index 0000000..f6a859e
--- /dev/null
+++ b/frontend/src/components/ai/LadderView.tsx
@@ -0,0 +1,90 @@
+import { useEffect, useMemo, useRef, useState } from "react";
+import { getAiLadder, getLadder, type AiLadderResponse, type ApiError, type BucketKey, type LadderResponse, type LadderRow } from "../../api/client";
+import { formatInt, formatMoney, formatPct, formatSignedCompact } from "../../lib/format";
+import { GapChart } from "../GapChart";
+import type { DrillPreset, PageMeta, Shared } from "./types";
+
+const pick = (src: LadderRow[] | undefined, currency: string, location: string) =>
+  (src ?? []).filter((r) => r.currency === currency && (location ? r.location === location : r.scope === "currency_total"));
+
+/** The AI-adjusted ladder itself: assets, liabilities and net gap per bucket (use case 5b), next to the deterministic net. */
+export function LadderView({ shared, onDrill, onMeta }: { shared: Shared; onDrill: (p: DrillPreset) => void; onMeta: (m: PageMeta) => void }) {
+  const { currency, setCurrency, location, setLocation } = shared;
+  const [ai, setAi] = useState<AiLadderResponse | null>(null);
+  const [base, setBase] = useState<LadderResponse | null>(null);
+  const [error, setError] = useState<ApiError | null>(null);
+  const seq = useRef(0);
+  useEffect(() => {
+    const mine = ++seq.current;
+    Promise.all([getAiLadder(), getLadder()]).then(([a, b]) => {
+      if (mine !== seq.current) return;
+      setAi(a); setBase(b); onMeta(a.metadata);
+      if (!currency) setCurrency(a.ladder[0]?.currency ?? "");
+    }, (e: ApiError) => { if (mine === seq.current) setError(e); });
+  }, []);   // eslint-disable-line react-hooks/exhaustive-deps
+
+  const ccy = currency || ai?.ladder[0]?.currency || "";
+  const rows = useMemo(() => pick(ai?.ladder, ccy, location), [ai, ccy, location]);
+  const detRows = useMemo(() => pick(base?.ladder, ccy, location), [base, ccy, location]);
+  const currencies = useMemo(() => [...new Set((ai?.ladder ?? []).map((r) => r.currency))], [ai]);
+  const locations = useMemo(() => [...new Set((ai?.ladder ?? []).filter((r) => r.currency === ccy && r.location).map((r) => r.location as string))].sort(), [ai, ccy]);
+  if (error) return <div className="banner" role="alert">{error.message}</div>;
+  if (!ai) return <p className="loading">Building the AI-adjusted ladder…</p>;
+  const md = ai.metadata;
+  const detNet = (b: BucketKey) => detRows.find((r) => r.bucket === b)?.net_gap ?? 0;
+  const go = (bucket: BucketKey) => onDrill({ bucket, currency: ccy, moved_only: false });
+
+  return (
+    <>
+      <section className="kpi-row" aria-label="Model summary">
+        <div className="kpi"><span>Contracts changing bucket</span><b>{formatInt(md.moved_count)}</b><small>{formatInt(md.shifted_count)} of {formatInt(md.transactions_read)} have an earlier date</small></div>
+        <div className="kpi"><span>Average early-exit chance</span><b>{formatPct(md.average_p_early)}</b><small>from today</small></div>
+        <div className="kpi"><span>Average move</span><b>{formatInt(Math.round(md.average_shift_days))} days</b><small>earlier, when moved</small></div>
+        <div className="kpi"><span>Model</span><b>AUC {md.model.holdout_auc ?? "–"}</b><small>F1 {md.model.holdout_f1 ?? "–"} · {formatInt(md.model.trained_on)} contracts</small></div>
+      </section>
+      <section className="card" aria-label="AI-adjusted ladder">
+        <div className="table-head">
+          <div role="tablist" aria-label="Currency" className="filters pills">
+            {currencies.map((c) => (
+              <button key={c} role="tab" type="button" aria-selected={c === ccy} className={c === ccy ? "btn ai" : "btn secondary"} onClick={() => { setCurrency(c); setLocation(""); }}>{c}</button>
+            ))}
+          </div>
+          <div className="filters">
+            <label>Location
+              <select value={location} onChange={(e) => setLocation(e.target.value)}>
+                <option value="">All locations</option>{locations.map((l) => <option key={l} value={l}>{l}</option>)}
+              </select>
+            </label>
+          </div>
+        </div>
+        <GapChart rows={rows} currency={ccy} onSelect={go} scope={`${location || md.scope_location || "all locations"} · AI-adjusted maturities`} />
+        <div className="table-wrap">
+          <table>
+            <thead><tr><th>Bucket</th><th className="num">Assets</th><th className="num">Liabilities</th><th className="num">Net gap (AI)</th><th className="num">Deterministic</th><th className="num">Shift</th><th className="num">Txns</th></tr></thead>
+            <tbody>
+              {rows.map((r) => {
+                const delta = r.net_gap - detNet(r.bucket);
+                return (
+                  <tr key={r.bucket}>
+                    <td><button type="button" className="link-btn ai" onClick={() => go(r.bucket)}>{r.bucket}</button></td>
+                    <td className="num mono">{formatMoney(r.asset_cash_at_maturity)}</td>
+                    <td className="num mono">{formatMoney(r.liability_cash_at_maturity)}</td>
+                    <td className="num mono" style={{ fontWeight: 600 }}>{formatMoney(r.net_gap)}</td>
+                    <td className="num mono muted">{formatMoney(detNet(r.bucket))}</td>
+                    <td className="num mono" data-tone={delta < 0 ? "shortfall" : delta > 0 ? "surplus" : undefined}>{formatSignedCompact(delta)}</td>
+                    <td className="num mono">{formatInt(r.asset_count + r.liability_count)}</td>
+                  </tr>
+                );
+              })}
+            </tbody>
+          </table>
+        </div>
+        <p className="meta">Same buckets and rules as the deterministic ladder; each contract sits at its AI-adjusted maturity with its cash amount unchanged.</p>
+      </section>
+      <details className="card">
+        <summary><b>Assumptions</b></summary>
+        <ul>{ai.assumptions.map((a) => <li key={a}>{a}</li>)}</ul>
+      </details>
+    </>
+  );
+}
diff --git a/frontend/src/components/ai/MonthlyChart.tsx b/frontend/src/components/ai/MonthlyChart.tsx
new file mode 100644
index 0000000..39e4ccd
--- /dev/null
+++ b/frontend/src/components/ai/MonthlyChart.tsx
@@ -0,0 +1,143 @@
+import { useEffect, useRef, useState } from "react";
+import type { MonthPoint } from "../../api/client";
+import { formatCompact, formatSignedCompact } from "../../lib/format";
+
+/** Cumulative net gap month by month (deterministic vs AI-adjusted, divergence shaded) and, underneath on its
+ *  own axis, the monthly difference AI − deterministic as bars you can click. Pure SVG at real pixel width. */
+
+const TOP_H = 250;
+const GAP_H = 34;
+const BAR_H = 104;
+const H = TOP_H + GAP_H + BAR_H + 18;
+const M = { left: 62, right: 14, top: 14 };
+
+const axis = (n: number) => {
+  const a = Math.abs(n);
+  const [d, u] = a >= 1e9 ? [1e9, "B"] : a >= 1e6 ? [1e6, "M"] : a >= 1e3 ? [1e3, "K"] : [1, ""];
+  return `${n < 0 ? "−" : n > 0 ? "+" : ""}${+(a / d).toFixed(1)}${u}`;
+};
+
+function ticks(lo: number, hi: number, n = 4): number[] {
+  const span = Math.max(1, hi - lo);
+  const raw = span / n;
+  const mag = 10 ** Math.floor(Math.log10(raw));
+  const step = [1, 2, 2.5, 5, 10].map((m) => m * mag).find((s) => s >= raw) ?? 10 * mag;
+  const out: number[] = [];
+  for (let v = Math.floor(lo / step) * step; v <= hi + step * 1e-9; v += step) out.push(Math.abs(v) < step * 1e-9 ? 0 : v);
+  if (out[out.length - 1] < hi) out.push(out[out.length - 1] + step);
+  return out;
+}
+
+function useWidth(fallback: number) {
+  const ref = useRef<HTMLDivElement>(null);
+  const [w, setW] = useState(fallback);
+  useEffect(() => {
+    const el = ref.current;
+    if (!el || typeof ResizeObserver === "undefined") return;
+    const ro = new ResizeObserver(([e]) => setW(Math.max(300, Math.round(e.contentRect.width))));
+    ro.observe(el);
+    return () => ro.disconnect();
+  }, []);
+  return [ref, w] as const;
+}
+
+export function MonthlyChart({ months, currency, selected, onSelect }: {
+  months: MonthPoint[];
+  currency: string;
+  selected: number | null;
+  onSelect: (month: number) => void;
+}) {
+  const [ref, W] = useWidth(720);
+  const [hover, setHover] = useState<number | null>(null);
+  const n = months.length - 1;
+  const plotW = W - M.left - M.right;
+  const x = (m: number) => M.left + (m / Math.max(1, n)) * plotW;
+
+  const cums = months.flatMap((m) => [m.det_cum, m.ai_cum, 0]);
+  const t1 = ticks(Math.min(...cums), Math.max(...cums));
+  const [lo1, hi1] = [t1[0], t1[t1.length - 1]];
+  const y1 = (v: number) => M.top + ((hi1 - v) / (hi1 - lo1 || 1)) * (TOP_H - M.top - 22);
+
+  const maxDiff = Math.max(1, ...months.map((m) => Math.abs(m.diff)));
+  const barTop = TOP_H + GAP_H;
+  const zeroBar = barTop + BAR_H / 2;
+  const y2 = (v: number) => zeroBar - (v / maxDiff) * (BAR_H / 2 - 4);
+  const bw = Math.max(3, Math.min(18, (plotW / Math.max(1, n)) * 0.62));
+
+  const path = (key: "det_cum" | "ai_cum") => months.map((m, i) => `${i ? "L" : "M"}${x(m.month)},${y1(m[key])}`).join("");
+  const band = `${months.map((m, i) => `${i ? "L" : "M"}${x(m.month)},${y1(m.ai_cum)}`).join("")}`
+    + [...months].reverse().map((m) => `L${x(m.month)},${y1(m.det_cum)}`).join("") + "Z";
+  const step = n > 12 ? 3 : 1;
+  const h = hover === null ? null : months[hover];
+  const tipLeft = h ? Math.min(Math.max(0, x(h.month) + 10), W - 230) : 0;
+  const summary = `Cumulative net gap over ${n} months in ${currency}: deterministic ends at ${axis(months[n]?.det_cum ?? 0)}, `
+    + `AI-adjusted at ${axis(months[n]?.ai_cum ?? 0)}.`;
+
+  return (
+    <figure className="monthly">
+      <figcaption>
+        <ul className="gapchart-legend monthly-legend">
+          <li><span className="line-key" style={{ background: "var(--series-det)" }} />Deterministic</li>
+          <li><span className="line-key" style={{ background: "var(--series-ai)" }} />AI-adjusted</li>
+          <li><span className="key" style={{ background: "var(--ai-soft)" }} />Divergence</li>
+        </ul>
+      </figcaption>
+      <div className="gapchart-plot" ref={ref} onPointerLeave={() => setHover(null)}>
+        <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={summary}>
+          {t1.map((t) => (
+            <g key={`t${t}`}>
+              <line x1={M.left} x2={W - M.right} y1={y1(t)} y2={y1(t)} stroke="var(--grid)" strokeDasharray={t === 0 ? "4 4" : undefined}
+                    style={t === 0 ? { stroke: "var(--axis)" } : undefined} />
+              <text x={M.left - 8} y={y1(t)} dy="0.32em" textAnchor="end" className="gapchart-tick">{axis(t)}</text>
+            </g>
+          ))}
+          {months.filter((m) => m.month % step === 0).map((m) => (
+            <text key={`x${m.month}`} x={x(m.month)} y={TOP_H - 4} textAnchor="middle" className="gapchart-tick">M{m.month}</text>
+          ))}
+          <path d={band} fill="var(--ai-soft)" stroke="none" />
+          <path d={path("det_cum")} fill="none" stroke="var(--series-det)" strokeWidth={2} />
+          <path d={path("ai_cum")} fill="none" stroke="var(--series-ai)" strokeWidth={2} />
+          {h && (
+            <g>
+              <line x1={x(h.month)} x2={x(h.month)} y1={M.top} y2={TOP_H - 20} stroke="var(--axis)" />
+              <circle cx={x(h.month)} cy={y1(h.det_cum)} r={4} fill="var(--surface)" stroke="var(--series-det)" strokeWidth={2} />
+              <circle cx={x(h.month)} cy={y1(h.ai_cum)} r={4} fill="var(--surface)" stroke="var(--series-ai)" strokeWidth={2} />
+            </g>
+          )}
+
+          <text x={M.left} y={barTop - 10} className="monthly-sub">AI minus deterministic, by month ({currency}) · click a bar to drill down</text>
+          <line x1={M.left} x2={W - M.right} y1={zeroBar} y2={zeroBar} stroke="var(--axis)" />
+          <text x={M.left - 8} y={barTop + 6} dy="0.32em" textAnchor="end" className="gapchart-tick">{axis(maxDiff)}</text>
+          <text x={M.left - 8} y={barTop + BAR_H - 6} dy="0.32em" textAnchor="end" className="gapchart-tick">{axis(-maxDiff)}</text>
+          {months.slice(1).map((m) => {
+            const cx = x(m.month);
+            const top = Math.min(zeroBar, y2(m.diff));
+            const hgt = Math.max(m.diff === 0 ? 0 : 1, Math.abs(y2(m.diff) - zeroBar));
+            return (
+              <g key={`b${m.month}`}>
+                {selected === m.month && <rect x={cx - bw / 2 - 4} y={barTop} width={bw + 8} height={BAR_H} rx={4} className="month-selected" />}
+                {hgt > 0 && <rect x={cx - bw / 2} y={top} width={bw} height={hgt} rx={2} fill={m.diff > 0 ? "var(--success)" : "var(--error)"} />}
+              </g>
+            );
+          })}
+          {months.map((m, i) => (
+            <rect key={`h${m.month}`} className="gapchart-hit" data-clickable={m.month ? "" : undefined}
+                  x={x(m.month) - plotW / Math.max(1, n) / 2} y={0} width={plotW / Math.max(1, n)} height={H}
+                  onPointerEnter={() => setHover(i)} onClick={() => m.month && onSelect(m.month)}>
+              <title>Month {m.month}</title>
+            </rect>
+          ))}
+        </svg>
+        {h && (
+          <div className="gapchart-tip" style={{ left: tipLeft, top: M.top, width: 220 }}>
+            <div className="tip-title"><b>Month {h.month}</b><span>to {h.end_date}{h.bucket ? ` · ${h.bucket}` : ""}</span></div>
+            <div className="tip-row"><i style={{ background: "var(--series-det)" }} /><b>{formatCompact(h.det_cum)}</b><span>Deterministic</span></div>
+            <div className="tip-row"><i style={{ background: "var(--series-ai)" }} /><b>{formatCompact(h.ai_cum)}</b><span>AI-adjusted</span></div>
+            {h.month > 0 && <div className="tip-row net"><span /><b>{formatSignedCompact(h.diff)}</b><span>this month</span></div>}
+            {h.month > 0 && <div className="tip-hint">{h.note}</div>}
+          </div>
+        )}
+      </div>
+    </figure>
+  );
+}
diff --git a/frontend/src/components/ai/WhyView.tsx b/frontend/src/components/ai/WhyView.tsx
new file mode 100644
index 0000000..a3c9e9b
--- /dev/null
+++ b/frontend/src/components/ai/WhyView.tsx
@@ -0,0 +1,126 @@
+import { useEffect, useRef, useState } from "react";
+import { getWhy, type ApiError, type WhyResponse } from "../../api/client";
+import { formatInt, formatPct, formatSignedCompact } from "../../lib/format";
+import { ModelCardPanel } from "../ModelCardPanel";
+import type { DrillPreset, PageMeta, Shared } from "./types";
+
+const SHADES = ["var(--ai-1)", "var(--ai-2)", "var(--ai-3)", "var(--ai-4)"];
+
+/** Bold the "Mostly <segment> <loans|deposits>" phrase and the market wording, like the design. */
+function Story({ text }: { text: string }) {
+  const parts = text.split(/(Mostly [A-Za-z]+ (?:loans|deposits)|above market|below market)/);
+  return (
+    <>
+      {parts.map((p, i) => {
+        if (i % 2 === 0) return p;
+        return p.startsWith("Mostly ") ? <span key={i}>Mostly <b>{p.slice(7)}</b></span> : <b key={i}>{p}</b>;
+      })}
+    </>
+  );
+}
+
+export function WhyView({ shared, onDrill, onMeta }: { shared: Shared; onDrill: (p: DrillPreset) => void; onMeta: (m: PageMeta) => void }) {
+  const { currency, location } = shared;
+  const [shift, setShift] = useState(0);
+  const [applied, setApplied] = useState(0);
+  const [data, setData] = useState<WhyResponse | null>(null);
+  const [error, setError] = useState<ApiError | null>(null);
+  const [aboutOpen, setAboutOpen] = useState(false);
+  const seq = useRef(0);
+
+  useEffect(() => {                                     // debounce the slider: one request after it stops moving
+    const t = setTimeout(() => setApplied(shift), 250);
+    return () => clearTimeout(t);
+  }, [shift]);
+  useEffect(() => {
+    const mine = ++seq.current;
+    setError(null);
+    getWhy({ currency: currency || undefined, location: location || undefined, market_shift_pp: applied })
+      .then((d) => { if (mine === seq.current) { setData(d); onMeta(d.metadata); } }, (e: ApiError) => { if (mine === seq.current) setError(e); });
+  }, [currency, location, applied]);
+
+  if (error) return <div className="banner" role="alert">{error.message}</div>;
+  if (!data) return <p className="loading">Working out why each bucket moved…</p>;
+  const sc = data.scenario;
+  const ccy = data.metadata.currency;
+  const loanArrow = sc.loans_repaid_early.change > 0 ? "↑" : sc.loans_repaid_early.change < 0 ? "↓" : "";
+  const depArrow = sc.deposits_withdrawn_early.change > 0 ? "↑" : sc.deposits_withdrawn_early.change < 0 ? "↓" : "";
+
+  return (
+    <>
+      <div className="ai-grid">
+        <section className="card" aria-label="Why each bucket moved">
+          <h2>Why each bucket moved</h2>
+          <p className="hint">{ccy}{location ? ` · ${location}` : ""} · click a bucket to drill into its contracts</p>
+          <ul className="why-list">
+            {data.buckets.map((b) => (
+              <li key={b.bucket}>
+                <button type="button" className="link-btn ai bucket-link" onClick={() => onDrill({ bucket: b.bucket, currency: ccy, moved_only: b.moved_in > 0 })}>{b.bucket}</button>
+                <p><Story text={b.text} />{b.largest && <b> Largest change.</b>}</p>
+                <span className="mono shift" data-tone={b.shift < 0 ? "shortfall" : b.shift > 0 ? "surplus" : undefined}>{formatSignedCompact(b.shift)}</span>
+              </li>
+            ))}
+          </ul>
+        </section>
+
+        <div className="stack">
+          <section className="card" aria-label="What drives the AI">
+            <h2>What drives the AI</h2>
+            <ul className="importance">
+              {data.drivers.map((d) => (
+                <li key={d.label}>
+                  <span>{d.label}</span>
+                  <span className="imp-bar" aria-hidden="true"><i style={{ width: `${Math.max(2, d.strength * 100)}%` }} /></span>
+                  <b>{d.level}</b>
+                </li>
+              ))}
+            </ul>
+          </section>
+
+          <section className="card" aria-label="Market-rate scenario">
+            <h2>Market-rate scenario</h2>
+            <p className="hint">Spread = contract rate − market rate</p>
+            <div className="slider-head">
+              <label htmlFor="mshift">Market rate shift</label>
+              <b className="mono ai-text">{shift > 0 ? "+" : shift < 0 ? "−" : ""}{Math.abs(shift).toFixed(1)} pp</b>
+            </div>
+            <input id="mshift" type="range" min={-2} max={2} step={0.1} value={shift} onChange={(e) => setShift(Number(e.target.value))}
+                   aria-valuetext={`${shift.toFixed(1)} percentage points`} className="ai-range" />
+            <div className="range-scale"><span>−2.0</span><span>0</span><span>+2.0 pp</span></div>
+            <dl className="scenario">
+              <div><dt>Loans likely repaid early</dt><dd>{loanArrow} {sc.loans_repaid_early.change > 0 ? "+" : ""}{formatInt(sc.loans_repaid_early.change)}</dd></div>
+              <div><dt>Deposits likely withdrawn early</dt><dd>{depArrow} {sc.deposits_withdrawn_early.change > 0 ? "+" : ""}{formatInt(sc.deposits_withdrawn_early.change)}</dd></div>
+              <div><dt>{sc.headline.bucket} gap</dt><dd className={sc.headline.scenario < 0 ? "neg" : "pos"}>{formatSignedCompact(sc.headline.base)} → {formatSignedCompact(sc.headline.scenario)}</dd></div>
+            </dl>
+            {applied !== shift && <p className="meta">Updating…</p>}
+            <p className="meta">{sc.note} Expected counts from {formatInt(Math.round(sc.loans_repaid_early.base))} loans and {formatInt(Math.round(sc.deposits_withdrawn_early.base))} deposits today.</p>
+          </section>
+        </div>
+      </div>
+
+      <section className="card" aria-label="Who moved">
+        <h2>Who moved</h2>
+        <p className="hint">{formatInt(data.who_moved.total)} contracts changed bucket, by segment and side</p>
+        {data.who_moved.total > 0 ? (
+          <>
+            <div className="stackbar" role="img" aria-label={data.who_moved.groups.map((g) => `${g.label} ${formatPct(g.share)}`).join(", ")}>
+              {data.who_moved.groups.map((g, i) => (
+                <i key={g.label} style={{ width: `${g.share * 100}%`, background: SHADES[i % SHADES.length] }} title={`${g.label}: ${g.count}`} />
+              ))}
+            </div>
+            <ul className="stack-legend">
+              {data.who_moved.groups.map((g, i) => (
+                <li key={g.label}><span className="key" style={{ background: SHADES[i % SHADES.length] }} />{g.label} {formatPct(g.share)}</li>
+              ))}
+            </ul>
+          </>
+        ) : <p className="empty">No contract changes bucket for this selection.</p>}
+      </section>
+
+      <details className="card" onToggle={(e) => setAboutOpen((e.target as HTMLDetailsElement).open)}>
+        <summary><b>About the model</b> <span className="meta">accuracy, F1, calibration, drivers, timing, assumptions, full prediction export</span></summary>
+        {aboutOpen && <ModelCardPanel />}
+      </details>
+    </>
+  );
+}
diff --git a/frontend/src/components/ai/types.ts b/frontend/src/components/ai/types.ts
new file mode 100644
index 0000000..fee11bd
