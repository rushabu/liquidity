+.segmented button:focus-visible { outline: none; box-shadow: inset 0 0 0 2px var(--series-ai); }
+.btn.ai { background: var(--series-ai); border-color: var(--series-ai); color: #fff; }
+.btn.ai-outline { color: var(--series-ai); border-color: var(--series-ai); }
+.link-btn.ai { color: var(--series-ai); font-weight: 600; }
+.ai-text { color: var(--series-ai); }
+.ai-filters { display: flex; justify-content: space-between; align-items: end; gap: var(--space-3); flex-wrap: wrap; }
+.drill-filters { justify-content: flex-start; }
+.drill-filters label { display: grid; gap: 2px; font-size: 12px; color: var(--muted); font-weight: 500; }
+.drill-filters select { height: 38px; padding: 0 var(--space-2); border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--surface); min-width: 120px; }
+.drill-filters .btn { margin-left: auto; height: 40px; }
+.pills .btn { min-width: 56px; }
+.kpi-row { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-3); }
+.kpi { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: var(--space-3) var(--space-4); display: grid; gap: 2px; min-width: 0; }
+.kpi span { font-size: 12.5px; color: var(--muted); }
+.kpi b { font-family: var(--font-mono); font-size: 21px; font-weight: 600; overflow-wrap: anywhere; }
+.kpi small { font-size: 12px; color: var(--muted); }
+.pos { color: var(--success); }
+.neg { color: var(--error); }
+.ai-grid { display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr); gap: var(--space-4); align-items: start; }
+.drill-grid { grid-template-columns: minmax(0, 1.9fr) minmax(0, 1fr); }
+.stack { display: grid; gap: var(--space-4); min-width: 0; }
+.card h2 { font-size: 17px; }
+table.compact { min-width: 0; }
+table.compact th, table.compact td { padding: 8px 10px; }
+table.drill-table { min-width: 0; }
+.drill-table th, .drill-table td { padding: 10px 8px; vertical-align: top; }
+.drill-table td:first-child, .drill-table .nowrap { white-space: nowrap; }
+.drill-table .pcell { white-space: nowrap; }
+.selected-month { margin-top: var(--space-3); padding: var(--space-3); border: 1px solid var(--border); border-radius: var(--radius-sm); }
+.selected-month p { margin: 4px 0; color: var(--muted); font-size: 13.5px; }
+.ranges, .overview { margin-top: var(--space-3); }
+.ranges summary, .overview summary { cursor: pointer; font-size: 13px; color: var(--muted); }
+
+.monthly-legend { margin-bottom: var(--space-2); }
+.line-key { width: 18px; height: 3px; border-radius: 2px; display: inline-block; }
+.monthly-sub { font-size: 12px; fill: var(--ink); font-weight: 600; }
+.month-selected { fill: none; stroke: var(--series-ai); stroke-dasharray: 4 3; stroke-width: 1.5; }
+
+.why-list { list-style: none; padding: 0; margin: var(--space-3) 0 0; }
+.why-list li { display: grid; grid-template-columns: 64px 1fr auto; gap: var(--space-3); align-items: start; padding: var(--space-3) 0; border-top: 1px solid var(--border); }
+.why-list p { margin: 0; font-size: 14px; line-height: 1.5; }
+.why-list .bucket-link { font-size: 15px; text-decoration: none; }
+.why-list .shift { font-weight: 600; white-space: nowrap; }
+.why-list [data-tone="shortfall"] { color: var(--error); }
+.why-list [data-tone="surplus"] { color: var(--success); }
+.importance { list-style: none; padding: 0; margin: var(--space-3) 0 0; display: grid; gap: 10px; }
+.importance li { display: grid; grid-template-columns: minmax(0, 1fr) minmax(80px, 1.4fr) 34px; gap: var(--space-3); align-items: center; font-size: 13.5px; }
+.imp-bar { height: 12px; background: var(--grid); border-radius: 6px; overflow: hidden; }
+.imp-bar i { display: block; height: 100%; background: var(--series-ai); border-radius: 6px; }
+.slider-head { display: flex; justify-content: space-between; align-items: baseline; margin-top: var(--space-2); font-size: 14px; }
+.ai-range { width: 100%; accent-color: var(--series-ai); margin: var(--space-2) 0 0; }
+.range-scale { display: flex; justify-content: space-between; font-size: 12px; color: var(--muted); }
+.scenario { margin: var(--space-3) 0 0; display: grid; gap: 6px; }
+.scenario div { display: flex; justify-content: space-between; gap: var(--space-3); font-size: 13.5px; }
+.scenario dt { color: var(--muted); }
+.scenario dd { margin: 0; font-family: var(--font-mono); font-weight: 600; }
+.stackbar { display: flex; height: 24px; border-radius: 6px; overflow: hidden; gap: 2px; margin-top: var(--space-3); background: var(--surface); }
+.stackbar i { display: block; height: 100%; min-width: 2px; }
+.stack-legend { list-style: none; padding: 0; margin: var(--space-2) 0 0; display: flex; flex-wrap: wrap; gap: 4px 16px; font-size: 12.5px; color: var(--muted); }
+.stack-legend li { display: inline-flex; align-items: center; gap: 6px; }
+.stack-legend .key { width: 10px; height: 10px; border-radius: 2px; }
+
+.drill-table th { white-space: nowrap; }
+.th-sort { background: none; border: 0; padding: 0; font: inherit; color: inherit; text-transform: inherit; letter-spacing: inherit; cursor: pointer; }
+tr.clickable { cursor: pointer; }
+tr.clickable:hover td { background: #f7f6fd; }
+.chips { display: flex; flex-wrap: wrap; gap: 4px; }
+.rchip { font-size: 12px; padding: 1px 8px; border-radius: 99px; border: 1px solid var(--border); background: var(--page); color: var(--muted); }
+.drill-table td.chips { min-width: 130px; }
+.rchip[data-tone="up"] { color: var(--success); border-color: var(--success); background: #fff; }
+.rchip[data-tone="down"] { color: var(--muted); }
+.rchip[data-tone="warn"] { color: var(--warning-text); border-color: #e9c46a; background: var(--warning-bg); }
+.why-panel { display: grid; gap: var(--space-2); align-content: start; position: sticky; top: var(--space-4); }
+.why-head { display: flex; align-items: start; gap: var(--space-2); }
+.why-head h2 { flex: 1; font-size: 17px; }
+.close-x { border: 0; background: none; font-size: 20px; line-height: 1; color: var(--muted); cursor: pointer; padding: 0 4px; }
+.lo-bars { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
+.lo-bars li { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(60px, 1fr) 46px; gap: var(--space-2); align-items: center; font-size: 13.5px; }
+.lo-bars b { text-align: right; font-size: 13px; }
+.lo-bar { position: relative; height: 12px; background: linear-gradient(to right, transparent calc(50% - 1px), var(--axis) calc(50% - 1px), var(--axis) calc(50% + 1px), transparent calc(50% + 1px)); }
+.lo-bar i { position: absolute; top: 0; height: 100%; border-radius: 2px; min-width: 2px; }
+.lo-bar i[data-dir="raises"] { background: var(--error); }
+.lo-bar i[data-dir="lowers"] { background: var(--success); }
+.lo-bar i[data-dir="neutral"] { background: var(--axis); }
+.exit-facts { margin: var(--space-2) 0 0; display: grid; }
+.exit-facts div { display: flex; justify-content: space-between; gap: var(--space-3); padding: 10px 0; border-top: 1px solid var(--border); font-size: 13.5px; }
+.exit-facts dt { font-weight: 600; }
+.exit-facts dd { margin: 0; text-align: right; font-family: var(--font-mono); }
+.exit-facts dd small { display: block; font-family: var(--font-sans); color: var(--muted); }
+.calib.clf li { grid-template-columns: 1.4fr repeat(4, 1fr); }
+
+@media (max-width: 1000px) { .ai-grid, .drill-grid { grid-template-columns: minmax(0, 1fr); } .why-panel { position: static; } }
+@media (max-width: 700px) {
+  .kpi-row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .segmented { width: 100%; }
+  .segmented button { flex: 1 1 45%; padding: 10px 8px; }
+  .drill-filters label { flex: 1 1 45%; }
+  .drill-filters select { width: 100%; min-width: 0; }
+  .drill-filters .btn { margin-left: 0; width: 100%; }
+  .why-list li { grid-template-columns: 52px 1fr; }
+  .why-list .shift { grid-column: 2; }
+}
