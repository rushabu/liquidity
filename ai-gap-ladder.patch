+import type { BucketKey, Segment, Side } from "../../api/client";
+
+/** State shared by the AI gap ladder tabs. "" = not filtered. */
+export interface Shared {
+  currency: string;
+  setCurrency: (c: string) => void;
+  location: string;
+  setLocation: (l: string) => void;
+}
+
+/** Filters handed to the Drill-down tab from a click on another tab. */
+export interface DrillPreset {
+  bucket?: BucketKey;
+  currency?: string;
+  side?: Side;
+  segment?: Segment;
+  moved_only?: boolean;
+}
+
+/** What the page header needs from whichever view loaded first. */
+export interface PageMeta { calculation_date: string; model: { name: string } }
diff --git a/frontend/src/lib/format.ts b/frontend/src/lib/format.ts
index 904b099..abed601 100644
--- a/frontend/src/lib/format.ts
+++ b/frontend/src/lib/format.ts
@@ -17,3 +17,12 @@ export function formatCompact(n: number): string {
   const s = a >= 1e9 ? `${(a / 1e9).toFixed(2)}B` : a >= 1e6 ? `${(a / 1e6).toFixed(1)}M` : a >= 1e3 ? `${(a / 1e3).toFixed(1)}K` : a.toFixed(0);
   return n < 0 ? `-${s}` : s;
 }
+
+export const formatPct = (p: number, digits = 0): string => `${(p * 100).toFixed(digits)}%`;
+
+/** Signed compact money for deltas: +12.3M / −4.5M (true minus sign). */
+export function formatSignedCompact(n: number): string {
+  if (n === 0) return "0";
+  const s = formatCompact(Math.abs(n));
+  return n > 0 ? `+${s}` : `−${s}`;
+}
