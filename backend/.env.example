# Copy to backend/.env and fill in. Never commit .env.

ENVIRONMENT=dev
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]

# Supabase -> Connect -> "Session pooler" (or Transaction pooler) connection string.
# Keep sslmode=require.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Auth (JWT claims: sub, role, location).
# Option A: shared HS256 secret.   Option B: leave JWT_SECRET empty and set SUPABASE_URL (JWKS).
JWT_SECRET=
SUPABASE_URL=
JWT_AUDIENCE=authenticated
# Local development only. Lets requests without a token act as a Support user. Keep false.
DEV_AUTH_BYPASS=false

MAX_UPLOAD_MB=25
