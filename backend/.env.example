ENVIRONMENT=dev
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]

# --- Database (Supabase Postgres) -------------------------------------------
# Supabase dashboard -> "Connect" (top bar) -> Session pooler -> copy the URI.
#   host  aws-<n>-<region>.pooler.supabase.com   port 5432   user postgres.<project-ref>
# Replace [YOUR-PASSWORD] (percent-encode special characters) and keep sslmode=require.
# (The Direct connection is IPv6-only unless you buy the IPv4 add-on; the Transaction
#  pooler on port 6543 also works, prepared statements are already disabled.)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Local Postgres instead (docker compose --profile localdb):
# DATABASE_URL=postgresql://postgres:postgres@localdb:5432/liquidplus
# Seconds per address before a connection attempt fails (requests then get a 503 instead of hanging).
DB_CONNECT_TIMEOUT=5

# --- Auth (JWT claims: sub, role, location; role/location read from app_metadata) ------
# Recommended: asymmetric signing keys. Set only SUPABASE_URL; keys come from its JWKS endpoint.
SUPABASE_URL=https://<project-ref>.supabase.co
# Only for a project still on the legacy HS256 shared secret (or the team's own auth module).
JWT_SECRET=
JWT_AUDIENCE=authenticated
# Local development ONLY: requests without a token act as a Support user. Keep false everywhere else.
DEV_AUTH_BYPASS=false

# --- Used ONLY by python -m scripts.setup_supabase (backend-only secrets, never in the frontend) ----
# Dashboard -> Project Settings -> API Keys -> service_role (legacy) or a Secret key (sb_secret_...)
SUPABASE_SERVICE_ROLE_KEY=
# Publishable / anon key (safe to be public). Only for scripts/get_token.py.
SUPABASE_ANON_KEY=
SEED_USER_PASSWORD=

# --- Ingestion ---------------------------------------------------------------
MAX_UPLOAD_MB=25
